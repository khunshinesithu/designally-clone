# Sanity — copy this file to .env.local and fill in the values.
#
# Get these by running `npx sanity init` (see the CMS section of README.md).
# Project id and dataset are public; they are safe to commit if you ever want to.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Only needed once, to run scripts/migrate-to-sanity.mjs.
# Create at https://sanity.io/manage -> your project -> API -> Tokens (Editor role).
# NEVER commit a real token — .env.local is gitignored.
SANITY_API_WRITE_TOKEN=
